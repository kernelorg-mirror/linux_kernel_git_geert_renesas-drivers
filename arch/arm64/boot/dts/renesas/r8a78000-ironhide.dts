/dts-v1/;
#include <dt-bindings/soc/renesas,r8a78000-mfis.h>
#include "r8a78000.dtsi"

/ {
	model = "Renesas Ironhide board based on r8a78000";
	compatible = "renesas,ironhide", "renesas,r8a78000";

	aliases {
		serial0 = &hscif0;
		serial1 = &hscif1;
	};

	chosen {
		stdout-path = "serial0:1843200n8";
	};

	firmware {
		scmi: scmi {
			compatible = "arm,scmi";
			mboxes = <&mfis_scp 2 MFIS_CHANNEL_TX>,
				 <&mfis_scp 2 MFIS_CHANNEL_RX>;
			mbox-names = "tx", "rx";
			shmem = <&scmi_tx_shmem>, <&scmi_rx_shmem>;
			arm,no-completion-irq;
			#address-cells = <1>;
			#size-cells = <0>;

			scmi_devpd: protocol@11 {
				reg = <0x11>;
				#power-domain-cells = <1>;
			};

			scmi_sys: protocol@12 {
				reg = <0x12>;
			};

			scmi_clk: protocol@14 {
				reg = <0x14>;
				#clock-cells = <1>;
			};

			scmi_reset: protocol@16 {
				reg = <0x16>;
				#reset-cells = <1>;
			};
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x80000000>;
	};

	memory@1080000000 {
		device_type = "memory";
		reg = <0x10 0x80000000 0x0 0x80000000>;
	};

	memory@1200000000 {
		device_type = "memory";
		reg = <0x12 0x00000000 0x1 0x00000000>;
	};

	memory@1400000000 {
		device_type = "memory";
		reg = <0x14 0x00000000 0x1 0x00000000>;
	};

	memory@1600000000 {
		device_type = "memory";
		reg = <0x16 0x00000000 0x1 0x00000000>;
	};

	memory@1800000000 {
		device_type = "memory";
		reg = <0x18 0x00000000 0x1 0x00000000>;
	};

	memory@1a00000000 {
		device_type = "memory";
		reg = <0x1a 0x00000000 0x1 0x00000000>;
	};

	memory@1c00000000 {
		device_type = "memory";
		reg = <0x1c 0x00000000 0x1 0x00000000>;
	};

	memory@1e00000000 {
		device_type = "memory";
		reg = <0x1e 0x00000000 0x1 0x00000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/* First 518 MiB is reserved for other purposes. */
		firmware@40000000 {
			reg = <0x0 0x40000000 0x0 0x20600000>;
			no-map;
		};

		/* Parameters set by IPL. */
		parameters@8c100000 {
			reg = <0x0 0x8c100000 0x0 0x00008000>;
			no-map;
		};

		/* TFA BL31. */
		tfa-bl31@8c200000 {
			reg = <0x0 0x8c200000 0x0 0x00080000>;
			no-map;
		};

		/* TEE TZ DRAM. */
		tee@8c400000 {
			reg = <0x0 0x8c400000 0x0 0x02000000>;
			no-map;
		};

		/* DRAM controller inline ECC areas */
		ecc@10cccc0000 {
			reg = <0x10 0xcccc0000 0x0 0x33340000>;
			no-map;
		};

		ecc@12cccc0000 {
			reg = <0x12 0xcccc0000 0x0 0x33340000>;
			no-map;
		};

		ecc@14cccc0000 {
			reg = <0x14 0xcccc0000 0x0 0x33340000>;
			no-map;
		};

		ecc@16cccc0000 {
			reg = <0x16 0xcccc0000 0x0 0x33340000>;
			no-map;
		};

		ecc@18cccc0000 {
			reg = <0x18 0xcccc0000 0x0 0x33340000>;
			no-map;
		};

		ecc@1acccc0000 {
			reg = <0x1a 0xcccc0000 0x0 0x33340000>;
			no-map;
		};

		ecc@1ccccc0000 {
			reg = <0x1c 0xcccc0000 0x0 0x33340000>;
			no-map;
		};

		ecc@1ecccc0000 {
			reg = <0x1e 0xcccc0000 0x0 0x33340000>;
			no-map;
		};
	};
};

&can_clk {
	clock-frequency = <40000000>;
};

&canfd0 {
	pinctrl-0 = <&canfd1_pins>,  <&canfd2_pins>, <&canfd3_pins>,
		    <&canfd4_pins>, <&canfd5_pins>, <&canfd6_pins>;
	pinctrl-names = "default";

	status = "okay";

	channel1 {
		status = "okay";
	};

	channel2 {
		status = "okay";
	};

	channel3 {
		status = "okay";
	};

	channel4 {
		status = "okay";
	};

	channel5 {
		status = "okay";
	};

	channel6 {
		status = "okay";
	};
};

&canfd1 {
	pinctrl-0 = <&canfd12_pins>, <&canfd13_pins>,  <&canfd14_pins>,
		    <&canfd15_pins>;
	pinctrl-names = "default";

	status = "okay";

	channel4 {
		status = "okay";
	};

	channel5 {
		status = "okay";
	};

	channel6 {
		status = "okay";
	};

	channel7 {
		status = "okay";
	};
};

&extal_clk {
	clock-frequency = <16666600>;
};

&extalr_clk {
	clock-frequency = <32768>;
};

&hscif0 {
	pinctrl-0 = <&hscif0_pins>;
	pinctrl-names = "default";

	uart-has-rtscts;
	status = "okay";
};

&hscif1 {
	pinctrl-0 = <&hscif1_pins>;
	pinctrl-names = "default";

	uart-has-rtscts;
	status = "okay";
};

&mfis_scp {
	status = "okay";
};

&msiof0 {
	pinctrl-0 = <&msiof0_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&msiof6 {
	pinctrl-0 = <&msiof6_pins>;
	pinctrl-names = "default";

	status = "okay";	// Mutually-exclusive with MAX96726A U136
};

&pfc {
	pinctrl-0 = <&can_clk_pins>, <&scif_clk_pins>;
	pinctrl-names = "default";

	can_clk_pins: can-clk {
		groups = "can_clk";
		function = "can_clk";
	};

	canfd1_pins: canfd1 {
		groups = "canfd1_data";
		function = "canfd1";
	};

	canfd2_pins: canfd2 {
		groups = "canfd2_data";
		function = "canfd2";
	};

	canfd3_pins: canfd3 {
		groups = "canfd3_data";
		function = "canfd3";
	};

	canfd4_pins: canfd4 {
		groups = "canfd4_data";
		function = "canfd4";
	};

	canfd5_pins: canfd5 {
		groups = "canfd5_data";
		function = "canfd5";
	};

	canfd6_pins: canfd6 {
		groups = "canfd6_data";
		function = "canfd6";
	};

	canfd12_pins: canfd12 {
		groups = "canfd12_data_b";
		function = "canfd12";
	};

	canfd13_pins: canfd13 {
		groups = "canfd13_data_b";
		function = "canfd13";
	};

	canfd14_pins: canfd14 {
		groups = "canfd14_data_b";
		function = "canfd14";
	};

	canfd15_pins: canfd15 {
		groups = "canfd15_data_b";
		function = "canfd15";
	};

	hscif0_pins: hscif0 {
		groups = "hscif0_data", "hscif0_ctrl";
		function = "hscif0";
	};

	hscif1_pins: hscif1 {
		groups = "hscif1_data", "hscif1_ctrl";
		function = "hscif1";
	};

	// MSIOF0 PIN HEADER (CN71)
	msiof0_pins: msiof0 {
		groups = "msiof0_clk", "msiof0_sync", "msiof0_txd", "msiof0_rxd", "msiof0_ss1",
			 "msiof0_ss2";
		function = "msiof0";
	};

	// MSIOF6_A PIN HEADER (CN72)
	msiof6_pins: msiof6 {
		groups = "msiof6_clk_a", "msiof6_txd_a", "msiof6_rxd_a", "msiof6_ss1_a",
			 "msiof6_ss2_a";
		function = "msiof6";
	};

	pwm0_pins: pwm0 {
		groups = "pwm0_a";
		function = "pwm0";
	};

	pwm1_pins: pwm1 {
		groups = "pwm1";
		function = "pwm1";
	};

	pwm2_pins: pwm2 {
		groups = "pwm2";
		function = "pwm2";
	};

	pwm3_pins: pwm3 {
		groups = "pwm3";
		function = "pwm3";
	};

	pwm4_pins: pwm4 {
		groups = "pwm4";
		function = "pwm4";
	};

	pwm5_pins: pwm5 {
		groups = "pwm5";
		function = "pwm5";
	};

	scif_clk_pins: scif-clk {
		groups = "scif_clk";
		function = "scif_clk";
	};

	tpu_pins: tpu {
		groups = "tpu_to0", "tpu_to1";
		function = "tpu";
	};
};

&pwm0 {
	pinctrl-0 = <&pwm0_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&pwm1 {
	pinctrl-0 = <&pwm1_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&pwm2 {
	pinctrl-0 = <&pwm2_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&pwm3 {
	pinctrl-0 = <&pwm3_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&pwm4 {
	pinctrl-0 = <&pwm4_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&pwm5 {
	pinctrl-0 = <&pwm5_pins>;
	pinctrl-names = "default";

	status = "okay";
};

&scif_clk {
	clock-frequency = <26000000>;
};

&stcm_transport {
	scmi_tx_shmem: sram@1200 {
		compatible = "arm,scmi-shmem";
		reg = <0x1200 0x0100>;
	};

	scmi_rx_shmem: sram@1300 {
		compatible = "arm,scmi-shmem";
		reg = <0x1300 0x100>;
	};
};

&tpu {
	pinctrl-0 = <&tpu_pins>;
	pinctrl-names = "default";

	//status = "okay";	// Mutually-exclusive with pwm4 and pwm5
};
