//
// Device Tree Overlay for MSIOF1 with SYS-DMAC0 and spidev on R-Car E3
//
// Copyright (C) 2020 Glider bv
//

/dts-v1/;
/plugin/;

&msiof1 {
	#address-cells = <1>;
	#size-cells = <0>;
	dmas = <&dmac0 0x43>, <&dmac0 0x42>;
	dma-names = "tx", "rx";
	status = "okay";

	spidev@0 {
		compatible = "spidev";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};
